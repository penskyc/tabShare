{
  "name": "tabshare",
  "version": "0.3.0",
  "private": true,
  "description": "Real-time shared guitar tab rooms: Guitar Pro rendering, synth playback, loops and live cursors.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-alphatab-assets.mjs",
    "dev": "concurrently -k -n server,web -c magenta,cyan \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test server/*.test.ts shared/*.test.ts desktop/convolver.test.mjs",
    "soundfonts": "node scripts/fetch-soundfonts.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@opendaw/nam-wasm": "^1.2.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "AGPL-3.0"
}
